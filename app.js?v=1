};

window.flipCam = async function() {
    try{
        if(scanner?.isScanning) await scanner.stop();
        scanner?.clear();
    }catch(e){}
    await new Promise(r=>setTimeout(r,350));
    facingMode=facingMode==='environment'?'user':'environment';
    scanner=new Html5Qrcode("reader");
    try{
        await scanner.start(
            { facingMode },
            { fps: 15, qrbox: { width: 240, height: 240 }, disableFlip: true, videoConstraints: { facingMode, width: { ideal: 640 }, height: { ideal: 480 } }, experimentalFeatures: { useBarCodeDetectorIfSupported: true } },
            text=>{scanner.pause();prosesQR(text);},
            ()=>{}
        );
    }catch(e){
        showToast('Gagal ganti kamera: '+e,'error');
        facingMode=facingMode==='environment'?'user':'environment';
    }
};

window.stopCam = function() {
    try{if(scanner?.isScanning)scanner.stop();}catch(e){}
    facingMode='environment';
    document.getElementById('btnStart').style.display='';document.getElementById('btnFlip').style.display='none';
    document.getElementById('btnStop').style.display='none';document.getElementById('cameraPlaceholder').style.display='';
};

function getModeAktif() {
    if(document.getElementById('modeHaid')?.classList.contains('active'))return'Haid';
    if(document.getElementById('modeKeputrian')?.classList.contains('active'))return'Keputrian';
    if(document.getElementById('modeKristen')?.classList.contains('active'))return'NonIslam';
    return'Islam';
}

function normalisasiNamaQR(v){return(v||'').toString().trim().replace(/\s+/g,' ').toUpperCase();}

function parseQRPresensi(text) {
    if(!text?.toString().trim())throw'QR kosong';
    const raw=text.toString().trim();
    if(raw.includes('|')){
        const p=raw.split('|').map(v=>v.trim());
        if(p.length!==5)throw'Bukan QR presensi';
        const[nama,kl,al,jk,ag]=p;
        if(!nama||!kl||!al||!jk||!ag)throw'Data tidak lengkap';
        return{legacy:true,nama:nama.trim(),kelas:kl.toUpperCase(),absen:al.replace(/\D/g,''),jk:jk.toUpperCase(),agama:ag.trim()};
    }
    if(/^KRH-[A-Z0-9]{6,10}$/i.test(raw)) return{legacy:false,kode:raw.toUpperCase()};
    throw'Format tidak dikenal';
}

async function resolveSiswaDariQR(text) {
    const parsed = parseQRPresensi(text);
    if (!parsed.legacy) {
        const idxSnap = await db.ref('kodeIndex/'+parsed.kode).once('value');
        if (!idxSnap.exists()) throw 'Kode tidak terdaftar';
        const { kelas, absen } = idxSnap.val();
        const ss = await db.ref('siswa/'+kelas+'/'+absen).once('value');
        if (!ss.exists()) throw 'Siswa tidak ditemukan';
        return { kelas, absen, data: ss.val(), namaQR: ss.val().nama };
    } else {
        const ref = db.ref('siswa/'+parsed.kelas+'/'+parsed.absen);
        const snap = await ref.once('value');
        if (!snap.exists()) throw 'Siswa tidak ditemukan';
        return { kelas:parsed.kelas, absen:parsed.absen, data:snap.val(), namaQR:parsed.nama };
    }
}

async function prosesQR(text) {
    mode=getModeAktif();
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const resolved = await resolveSiswaDariQR(text);
        const kelas=resolved.kelas, absen=resolved.absen;
        const ref=db.ref('siswa/'+kelas+'/'+absen);
        let ds=resolved.data||{};
        if(ds.nama&&resolved.namaQR&&normalisasiNamaQR(ds.nama)!==normalisasiNamaQR(resolved.namaQR))throw'QR tidak cocok';
        let nama=ds.nama||resolved.namaQR;let jk=(ds.jk||'L').toUpperCase();let agama=ds.agama||'Islam';
        if(mode==='Haid'||mode==='Keputrian'){if(jk!=='P')throw`Mode ${mode} hanya untuk perempuan!`;}
        else{
            const am=agama==='Islam'?'Islam':'NonIslam';
            if(am!==mode)throw agama==='Islam'?'Gunakan mode Islam':'Gunakan mode Non Islam';
        }
        const today=new Date().toLocaleDateString('id-ID').replace(/\//g,'-');
        const pr=db.ref('presensi/'+today+'/'+kelas+'_'+absen);
        if((await pr.once('value')).exists())throw'Sudah absen!';
        let th=(ds.totalHadir||0)+1;
        await ref.set({...ds,nama,kelas,absen,jk,agama,totalHadir:th,lastUpdate:Date.now()});
        const jam=(mode==='Haid'||mode==='Keputrian')?mode.toUpperCase():new Date().toLocaleTimeString('id-ID');
        const status=mode==='Islam'?'DZUHUR':mode==='Haid'?'HAID':mode==='Keputrian'?'KEPUTRIAN':'IBADAH';
        await pr.set({nama,kelas,absen,jk,agama,jam,status,totalHadir:th,timestamp:Date.now()});
        const msg=mode==='Haid'?'Tercatat Haid':mode==='Keputrian'?'Hadir Keputrian':`Hadir ke-${th}`;
        feedback('✅',nama,msg,'var(--accent-green)');
        showToast(`${nama} — ${msg}`,'success');playBeep('success');
    }catch(e){
        feedback('❌','GAGAL',e.toString(),'var(--accent-red)');
        showToast(e.toString(),'error');playBeep('error');
    }
    document.getElementById('loadingOverlay').classList.remove('show');
    setTimeout(()=>{try{scanner?.resume();}catch(e){}},800);
}

function feedback(icon,name,msg,bg) {
    const fb=document.getElementById('feedback');
    document.getElementById('fbIcon').innerText=icon;
    document.getElementById('fbNama').innerText=name;
    document.getElementById('fbMsg').innerText=msg;
    document.getElementById('fbBox').style=`text-align:center;padding:24px 32px;border-radius:16px;background:${bg};`;
    fb.classList.add('show');
    setTimeout(()=>fb.classList.remove('show'),1200);
}

async function loadManualAbsenOptions() {
    const kelas=document.getElementById('manualKelas')?.value;
    const ma=document.getElementById('manualAbsen'),mn=document.getElementById('manualNama');
    if(!ma||!mn)return;
    ma.innerHTML='<option value="">Pilih</option>';mn.value='';
    if(!kelas)return;
    const snap=await db.ref('siswa/'+kelas).once('value');
    const d=snap.val()||{};
    Object.keys(d).map(Number).sort((a,b)=>a-b).forEach(no=>{
        ma.innerHTML+=`<option value="${no}">${no} — ${d[no].nama||'-'}</option>`;
    });
    ma.onchange=async function(){
        const a=this.value;
        if(!a){mn.value='';return;}
        const s=await db.ref('siswa/'+kelas+'/'+a).once('value');
        mn.value=s.val()?.nama||'';
    };
}


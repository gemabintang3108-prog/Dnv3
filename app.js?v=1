const SHEET_COLS=3, SHEET_ROWS=4, SHEET_PER_PAGE=SHEET_COLS*SHEET_ROWS;
async function buatHalamanCetak(kartuList) {
    const PAGE_W=1654, PAGE_H=2339, MARGIN=50, GUTTER=18;
    const cellW=(PAGE_W-2*MARGIN-(SHEET_COLS-1)*GUTTER)/SHEET_COLS;
    const cellH=(PAGE_H-2*MARGIN-(SHEET_ROWS-1)*GUTTER)/SHEET_ROWS;
    let cardW=cellW, cardH=cardW*(CARD_H/CARD_W);
    if (cardH>cellH) { cardH=cellH; cardW=cardH*(CARD_W/CARD_H); }
    const page=document.createElement('canvas');
    page.width=PAGE_W; page.height=PAGE_H;
    const ctx=page.getContext('2d');
    ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,PAGE_W,PAGE_H);
    ctx.strokeStyle='#dddddd'; ctx.lineWidth=1; ctx.setLineDash([4,4]);
    kartuList.forEach((item,i)=>{
        const col=i%SHEET_COLS, row=Math.floor(i/SHEET_COLS);
        const cellX=MARGIN+col*(cellW+GUTTER), cellY=MARGIN+row*(cellH+GUTTER);
        const x=cellX+(cellW-cardW)/2, y=cellY+(cellH-cardH)/2;
        ctx.drawImage(item.canvas, x, y, cardW, cardH);
        ctx.strokeRect(cellX,cellY,cellW,cellH);
    });
    return page;
}


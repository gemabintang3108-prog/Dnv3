let logRenderScheduled = false, logRenderSnapshotVal = null;
const LOG_LIST_MAX_RENDER = 40;

function scheduleLogRender(dataVal) {
    logRenderSnapshotVal = dataVal;
    if (logRenderScheduled) return;
    logRenderScheduled = true;
    requestAnimationFrame(() => {
        logRenderScheduled = false;
        renderLogPresensi(logRenderSnapshotVal);
    });
}

function renderLogPresensi(d) {
    const entries = Object.values(d || {});
    const th = entries.filter(e => e.status !== 'TIDAK HADIR').length;
    const totalHadirEl = document.getElementById('totalHadir');
    if (totalHadirEl) totalHadirEl.innerText = th;
    const homeHadirEl = document.getElementById('homeHadir');
    if (homeHadirEl) homeHadirEl.innerText = th;
    const lc = document.getElementById('logPresensi');
    if (!lc) return;
    if (entries.length === 0) { lc.innerHTML = '<div class="empty-placeholder"><i class="fas fa-inbox"></i><p>Belum ada presensi</p></div>'; return; }
    entries.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
    const shown = entries.slice(0, LOG_LIST_MAX_RENDER);
    lc.innerHTML = shown.map(e => {
        let cls = '', bc = 'chip-hadir', bt = `#${e.totalHadir}`;
        if (e.status === 'TIDAK HADIR') { cls = 'entry-alpa'; bc = 'chip-alpa'; bt = 'ALPA'; }
        else if (e.jam === 'HAID') { cls = 'entry-haid'; bc = 'chip-haid'; bt = 'HAID'; }
        else if (e.jam === 'KEPUTRIAN') { cls = 'entry-keputrian'; bt = 'PUTRI'; }
        else if (e.status === 'IBADAH') { cls = 'entry-nonislam'; bt = 'IBADAH'; }
        return `<div class="log-entry ${cls}"><div><div class="log-entry-name">${e.nama}</div><div class="log-entry-detail">${e.kelas} • ${e.status}${e.status !== 'TIDAK HADIR' ? ' • ' + e.jam : ''}</div></div><div class="chip ${bc}">${bt}</div></div>`;
    }).join('') + (entries.length > LOG_LIST_MAX_RENDER ? `<div style="text-align:center;font-size:10px;color:var(--text-tertiary);padding:8px;">+${entries.length - LOG_LIST_MAX_RENDER} lainnya (lihat Download)</div>` : '');
}


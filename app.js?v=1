window.buatQR = async function() {
    const nama=document.getElementById('nama').value.trim(),kelas=document.getElementById('kelas').value;
    const absen=document.getElementById('absen').value.trim(),jk=document.getElementById('jk').value,agama=document.getElementById('agama').value;
    const colorKey=document.getElementById('warnaKartu')?.value||'navy';
    if(!nama||!absen){showToast('Lengkapi data!','error');playBeep('error');return;}

    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const namaUp = nama.toUpperCase();

        const slotDipakai = await cekSlotSudahDipakai(kelas, absen);
        if (slotDipakai) {
            throw new Error(`Absen ${absen} di kelas ${kelas} sudah dipakai oleh "${slotDipakai.nama}". Gunakan nomor absen lain.`);
        }
        const namaBentrok = await cekNamaSudahAda(namaUp, null, null);
        if (namaBentrok) {
            throw new Error(`Nama "${namaUp}" sudah terdaftar di kelas ${namaBentrok.kelas} absen ${namaBentrok.absen}.`);
        }

        const kode = await generateKodeUnik();
        await db.ref('siswa/'+kelas+'/'+absen).set({nama:namaUp,kelas,absen,jk,agama,kodeUnik:kode,warnaKartu:colorKey,totalHadir:0,terdaftar:Date.now()});
        await db.ref('kodeIndex/'+kode).set({kelas,absen});
        const canvas = await generateKartuCanvas({nama:namaUp,agama,kode,colorKey});
        const dataUrl = canvas.toDataURL('image/png');
        const area=document.getElementById('qrArea');
        area.innerHTML=`<div style="background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:16px;text-align:center;margin-top:12px;">
            <img src="${dataUrl}" style="width:100%;max-width:260px;border-radius:10px;box-shadow:var(--shadow-md);">
            <div style="font-size:10px;color:var(--text-tertiary);margin-top:8px;">${kelas} • ${jk==='L'?'Laki-laki':'Perempuan'} • ${agama} • Absen ${absen} • Kode ${kode}</div>
            <button class="btn btn-primary btn-sm" style="margin-top:10px;" onclick="downloadDataUrl('${dataUrl}','KARTU_${namaUp.replace(/\s+/g,'_')}.png')"><i class="fas fa-download"></i> Download Kartu</button>
        </div>`;
        showToast('Kartu berhasil dibuat!','success');playBeep('success');
        updateDashboard();loadManualAbsenOptions();
    }catch(e){showToast('Gagal: '+errMsg(e),'error');playBeep('error');}
    document.getElementById('loadingOverlay').classList.remove('show');
};


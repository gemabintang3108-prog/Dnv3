window.alpakanSemuaKosong = async function() {
    const tt=document.getElementById('tanggalHarian')?.value?.replace('__ALL__','')||new Date().toLocaleDateString('id-ID').replace(/\//g,'-');
    if(!confirm(`Alpakan semua yang belum absen di ${tt}?`))return;
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const ss=await db.ref('siswa').once('value'),s=ss.val()||{};
        const ps=await db.ref('presensi/'+tt).once('value'),p=ps.val()||{};
        const up={};let t=0;
        for(let k in s)for(let a in s[k]){
            if(p[`${k}_${a}`])continue;
            const d=s[k][a]||{};
            up[`presensi/${tt}/${k}_${a}`]={nama:d.nama||'-',kelas:k,absen:a,jk:d.jk||'',agama:d.agama||'',jam:'TIDAK HADIR',status:'TIDAK HADIR',totalHadir:d.totalHadir||0,timestamp:Date.now(),manual:true,autoAlpa:true};
            t++;
        }
        if(t===0)showToast('Semua sudah absen','success');
        else{await db.ref().update(up);showToast(`${t} siswa ALPA`,'success');updateDashboard();}
    }catch(e){showToast('Gagal','error');}
    document.getElementById('loadingOverlay').classList.remove('show');
};

function agamaIsIslam(a){return String(a||'').trim().toLowerCase()==='islam';}
function isHaidCell(h,s){return h&&(String(h.status||'').toUpperCase()==='HAID'||String(h.jam||'').toUpperCase()==='HAID')&&agamaIsIslam(h.agama||s?.agama||'')&&String(h.jk||s?.jk||'').toUpperCase()==='P';}
function isKeputrianCell(h){return h&&(String(h.status||'').toUpperCase()==='KEPUTRIAN'||String(h.jam||'').toUpperCase()==='KEPUTRIAN');}
function isNonMuslimHadirCell(h,s){return h&&String(h.status||'').toUpperCase()!=='TIDAK HADIR'&&String(h.status||'').toUpperCase()!=='HAID'&&String(h.status||'').toUpperCase()!=='KEPUTRIAN'&&!agamaIsIslam(h.agama||s?.agama||'');}
function isManualCell(h){return!!h?.manual;}

function beriWarnaJam(ws,r,c,color){
    const ref=XLSX.utils.encode_cell({r,c});
    if(ws[ref])ws[ref].s={fill:{patternType:'solid',fgColor:{rgb:color}},font:{bold:true,color:{rgb:'000000'}},alignment:{horizontal:'center',vertical:'center'}};
}

window.downloadHarian = async function() {
    const key=document.getElementById('tanggalHarian')?.value;
    if(!key){showToast('Pilih tanggal','error');return;}
    if(key==='__ALL__'){await downloadRekapBulanan();return;}
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const[d,m,y]=key.split('-').map(Number),tgl=new Date(y,m-1,d);
        const header=`${NAMA_HARI[tgl.getDay()]}, ${tgl.toLocaleDateString('id-ID')}`;
        const zip=new JSZip();
        const ss=await db.ref('siswa').once('value'),s=ss.val()||{};
        const ps=await db.ref('presensi/'+key).once('value'),p=ps.val()||{};
        for(let k in s){
            const daftar=Object.keys(s[k]).map(Number).sort((a,b)=>a-b);
            const rows=[['NO','NAMA',header,'STATUS']],warna=[];
            let hd=0;
            daftar.forEach(no=>{
                const si=s[k][no]||{},h=p[`${k}_${no}`],ri=rows.length;
                if(h){
                    if(h.status==='TIDAK HADIR'){rows.push([no,si.nama||h.nama||'-','TIDAK HADIR','❌']);warna.push({r:ri,c:2,color:'FF0000'});}
                    else{
                        rows.push([no,si.nama||h.nama||'-',h.jam||'HADIR','✅']);hd++;
                        if(isManualCell(h))warna.push({r:ri,c:2,color:'FF0000'});
                        else if(isHaidCell(h,si))warna.push({r:ri,c:2,color:'FFC0CB'});
                        else if(isKeputrianCell(h))warna.push({r:ri,c:2,color:'D8BFD8'});
                        else if(isNonMuslimHadirCell(h,si))warna.push({r:ri,c:2,color:'FFFF00'});
                    }
                }else rows.push([no,si.nama||'-','','']);
            });
            rows.push([],['',`TOTAL: ${hd}`,'','']);
            const ws=XLSX.utils.aoa_to_sheet(rows);
            warna.forEach(w=>beriWarnaJam(ws,w.r,w.c,w.color));
            ws['!cols']=[{wch:8},{wch:28},{wch:20},{wch:8}];
            const wb=XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb,ws,'Presensi');
            zip.file(`HARIAN_${k}_${key}.xlsx`,XLSX.write(wb,{bookType:'xlsx',type:'array'}));
        }
        const blob=await zip.generateAsync({type:'blob'});
        const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`HARIAN_${key}.zip`;a.click();
        showToast('Download selesai!','success');
    }catch(e){showToast('Gagal','error');}
    document.getElementById('loadingOverlay').classList.remove('show');
};

async function downloadRekapBulanan() {
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const bv=document.getElementById('pilihBulan')?.value;
        let tgl=new Date();
        if(bv){const[y,m]=bv.split('-');tgl=new Date(y,m-1,1);}
        const bln=tgl.getMonth(),thn=tgl.getFullYear();
        const ft=d=>d.toLocaleDateString('id-ID').replace(/\//g,'-');
        const fh=d=>`${NAMA_HARI[d.getDay()]} ${d.getDate()}/${d.getMonth()+1}`;
        const st=[];
        for(let i=1;i<=new Date(thn,bln+1,0).getDate();i++){const d=new Date(thn,bln,i);if(d.getDay()>=1&&d.getDay()<=5)st.push(d);}
        const pb={};
        for(let d of st){const k=ft(d);pb[k]=(await db.ref('presensi/'+k).once('value')).val()||{};}
        const ss=await db.ref('siswa').once('value'),s=ss.val()||{};
        const zip=new JSZip();
        const nb=tgl.toLocaleDateString('id-ID',{month:'long',year:'numeric'}).replace(/\s/g,'_');
        for(let k in s){
            const df=Object.keys(s[k]).map(Number).sort((a,b)=>a-b);
            const hdr=['NO','NAMA',...st.map(fh),'TOTAL'],rows=[hdr],warna=[];
            df.forEach(no=>{
                const si=s[k][no]||{},row=[no,si.nama||'-'];const ri=rows.length;let t=0;
                st.forEach((d,i)=>{
                    const h=(pb[ft(d)]||{})[`${k}_${no}`],ci=2+i;
                    if(h){
                        if(h.status==='TIDAK HADIR'){row.push('TIDAK HADIR');warna.push({r:ri,c:ci,color:'FF0000'});}
                        else{
                            row.push(h.jam||'HADIR');t++;
                            if(isManualCell(h))warna.push({r:ri,c:ci,color:'FF0000'});
                            else if(isHaidCell(h,si))warna.push({r:ri,c:ci,color:'FFC0CB'});
                            else if(isKeputrianCell(h))warna.push({r:ri,c:ci,color:'D8BFD8'});
                            else if(isNonMuslimHadirCell(h,si))warna.push({r:ri,c:ci,color:'FFFF00'});
                        }
                    }else row.push('');
                });
                row.push(t);rows.push(row);
            });
            const ws=XLSX.utils.aoa_to_sheet(rows);
            warna.forEach(w=>beriWarnaJam(ws,w.r,w.c,w.color));
            ws['!cols']=[{wch:8},{wch:28},...st.map(()=>({wch:14})),{wch:10}];
            const wb=XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb,ws,'Rekap');
            zip.file(`REKAP_${k}_${nb}.xlsx`,XLSX.write(wb,{bookType:'xlsx',type:'array'}));
        }
        const blob=await zip.generateAsync({type:'blob'});
        const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`REKAP_${nb}.zip`;a.click();
        showToast('Download selesai!','success');
    }catch(e){showToast('Gagal','error');}
    document.getElementById('loadingOverlay').classList.remove('show');
}


function jenjangDariKelas(k) {
    const s = String(k||'').toUpperCase();
    if (s.startsWith('XII')) return 'XII';
    if (s.startsWith('XI')) return 'XI';
    if (s.startsWith('X')) return 'X';
    return s;
}

function loadImage(src) {
    return new Promise((resolve,reject)=>{
        if (!src) { reject(new Error('Sumber gambar kosong')); return; }
        const img = new Image();
        img.onload = ()=>resolve(img);
        img.onerror = ()=>reject(new Error('Gagal memuat gambar (src tidak valid/kosong)'));
        img.src = src;
    });
}

async function qrDataUrl(text, size) {
    const div = document.createElement('div');
    div.style.cssText = 'position:absolute;left:-9999px;top:-9999px;';
    document.body.appendChild(div);
    new QRCode(div, { text, width:size, height:size, correctLevel: QRCode.CorrectLevel.M });
    let el = div.querySelector('canvas');
    if (!el || el.width === 0) {
        await new Promise(r=>setTimeout(r,350));
        el = div.querySelector('canvas') || div.querySelector('img');
    }
    if (!el) {
        document.body.removeChild(div);
        throw new Error('Gagal membuat QR code (elemen tidak ditemukan)');
    }
    const url = el.tagName==='CANVAS' ? el.toDataURL('image/png') : el.src;
    document.body.removeChild(div);
    if (!url || url === 'data:,') throw new Error('QR code gagal dirender (kosong)');
    return url;
}

async function generateKodeUnik() {
    const ALPHA = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
    for (let i=0;i<10;i++) {
        let rand = '';
        for (let j=0;j<8;j++) rand += ALPHA[Math.floor(Math.random()*ALPHA.length)];
        const kode = 'KRH-'+rand;
        const snap = await db.ref('kodeIndex/'+kode).once('value');
        if (!snap.exists()) return kode;
    }
    return 'KRH-'+Date.now().toString(36).toUpperCase()+Math.floor(Math.random()*99);
}


window.lanjutkanImportExcel = async function() {
    if(!importParsedData){showToast('Baca file dulu','error');return;}
    const semua=importParsedData;
    const kl=Object.keys(semua);
    const warnaPerJenjang={};
    [...new Set(kl.map(jenjangDariKelas))].forEach(j=>{
        warnaPerJenjang[j]=document.getElementById('warnaJenjang_'+j)?.value||'navy';
    });

    document.getElementById('loadingOverlay').classList.add('show');
    const pg=document.getElementById('importProgress'),rs=document.getElementById('importResult');
    pg.style.display='';rs.style.display='none';pg.innerText='Menyimpan & membuat kartu...';
    try{
        const zip=new JSZip();
        let t=0;
        const semuaDilewati=[];

        for(let k of kl){
            const colorKey = warnaPerJenjang[jenjangDariKelas(k)] || 'navy';
            const folderKartu=zip.folder('Kartu/'+k);
            const kartuCanvasList=[];
            for(let s of semua[k]){
                const slotDipakai = await cekSlotSudahDipakai(k, s.no);
                if (slotDipakai) {
                    semuaDilewati.push(`${k} #${s.no} — slot sudah dipakai oleh "${slotDipakai.nama}"`);
                    continue;
                }
                const namaBentrok = await cekNamaSudahAda(s.nama, null, null);
                if (namaBentrok) {
                    semuaDilewati.push(`${s.nama} — sudah ada di ${namaBentrok.kelas} #${namaBentrok.absen}`);
                    continue;
                }

                const kode = await generateKodeUnik();
                await db.ref('siswa/'+k+'/'+s.no).set({nama:s.nama,kelas:k,absen:s.no,jk:s.jk==='P'?'P':'L',agama:s.agama,kodeUnik:kode,warnaKartu:colorKey,totalHadir:0,terdaftar:Date.now()});
                await db.ref('kodeIndex/'+kode).set({kelas:k,absen:s.no});
                const canvas = await generateKartuCanvas({nama:s.nama,agama:s.agama,kode,colorKey});
                const blob = await canvasToBlob(canvas);
                folderKartu.file(`${s.no}_${s.nama.replace(/\s+/g,'_')}.png`, blob);
                kartuCanvasList.push({canvas});
                t++;
                pg.innerText=`Generate kartu: ${t} siswa...`;
            }
            if (kartuCanvasList.length>0) {
                const folderCetak=zip.folder('Cetak_SiapPrint/'+k);
                for(let i=0;i<kartuCanvasList.length;i+=SHEET_PER_PAGE){
                    const chunk=kartuCanvasList.slice(i,i+SHEET_PER_PAGE);
                    const page=await buatHalamanCetak(chunk);
                    const pageBlob=await canvasToBlob(page);
                    folderCetak.file(`Halaman_${Math.floor(i/SHEET_PER_PAGE)+1}.png`, pageBlob);
                }
            }
        }

        if (t>0) {
            const blob=await zip.generateAsync({type:'blob'});
            const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`KARTU_IBADAH_${new Date().toLocaleDateString('id-ID').replace(/\//g,'-')}.zip`;a.click();
        }

        let hasilHtml = `<div style="background:rgba(74,222,128,0.06);border:1px solid rgba(74,222,128,0.2);border-radius:var(--radius-sm);padding:10px;font-size:11px;color:var(--accent-green);text-align:center;">✅ ${t} kartu dari ${kl.length} kelas — folder "Kartu" (per siswa) & "Cetak_SiapPrint" (siap print, ${SHEET_PER_PAGE}/halaman)</div>`;
        if (semuaDilewati.length>0) {
            hasilHtml += `<div style="background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.2);border-radius:var(--radius-sm);padding:10px;font-size:10px;color:var(--accent-red);margin-top:8px;max-height:180px;overflow-y:auto;">
                <strong>⚠️ ${semuaDilewati.length} data dilewati (duplikat):</strong><br>
                ${semuaDilewati.map(x=>'• '+x).join('<br>')}
            </div>`;
        }
        rs.style.display='';rs.innerHTML=hasilHtml;
        pg.style.display='none';
        showToast(t>0 ? `${t} kartu berhasil dibuat!` : 'Tidak ada kartu baru dibuat (semua duplikat)', t>0?'success':'error');
        document.getElementById('warnaJenjangArea').style.display='none';
        importParsedData=null;
        updateDashboard();loadManualAbsenOptions();
    }catch(e){showToast('Gagal: '+errMsg(e),'error');pg.innerText='❌ '+errMsg(e);}
    document.getElementById('loadingOverlay').classList.remove('show');
};

window.startScanNaikKelas = function() {
    document.getElementById('btnStartNaik').style.display='none';document.getElementById('btnStopNaik').style.display='';
    scannerNaik=new Html5Qrcode("readerNaik");
    scannerNaik.start(
        { facingMode: "environment" },
        { fps: 15, qrbox: 180, disableFlip: true, videoConstraints: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } }, experimentalFeatures: { useBarCodeDetectorIfSupported: true } },
        text=>{scannerNaik.pause();prosesQRNaik(text);},()=>{}
    ).catch(e=>{
        showToast('Gagal: '+e,'error');
        document.getElementById('btnStartNaik').style.display='';document.getElementById('btnStopNaik').style.display='none';
    });
};

window.stopScanNaikKelas = function() {
    try{if(scannerNaik?.isScanning)scannerNaik.stop();}catch(e){}
    document.getElementById('btnStartNaik').style.display='';document.getElementById('btnStopNaik').style.display='none';
};

async function prosesQRNaik(text) {
    try{
        const resolved = await resolveSiswaDariQR(text);
        const kl=resolved.kelas, al=resolved.absen;
        const nama = resolved.data?.nama || resolved.namaQR;
        if(listSiswaScanned.find(s=>s.nama.toUpperCase()===nama.toUpperCase())){
            showFeedbackNaik('⚠️',nama,'Sudah discan!','var(--accent-amber)');
            setTimeout(()=>scannerNaik?.resume(),1500);return;
        }
        const data={...resolved.data,kelasLama:kl,absenLama:al};
        listSiswaScanned.push(data);renderListNaik();
        showFeedbackNaik('✅',data.nama||nama,`Ditambahkan (${listSiswaScanned.length})`,'var(--accent-green)');
        playBeep('success');
    }catch(e){
        showFeedbackNaik('❌','GAGAL',e.toString(),'var(--accent-red)');
        playBeep('error');
    }
    setTimeout(()=>{try{scannerNaik?.resume();}catch(e){}},1800);
}

function showFeedbackNaik(icon,nama,msg,bg){
    const fb=document.getElementById('feedbackNaik');
    document.getElementById('fbNaikIcon').innerText=icon;
    document.getElementById('fbNaikNama').innerText=nama;
    document.getElementById('fbNaikMsg').innerText=msg;
    document.getElementById('fbNaikBox').style=`text-align:center;padding:20px 28px;border-radius:14px;background:${bg};`;
    fb.classList.add('show');
    setTimeout(()=>fb.classList.remove('show'),1800);
}

function renderListNaik(){
    const c=document.getElementById('listScanNaik');
    if(!c)return;
    if(listSiswaScanned.length===0){c.innerHTML='<div class="empty-placeholder"><i class="fas fa-user-plus"></i><p>Belum ada scan</p></div>';return;}
    c.innerHTML=listSiswaScanned.map((s,i)=>`
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:var(--radius-sm);">
            <div><div style="font-size:12px;font-weight:700;color:var(--text-primary);">${s.nama}</div><div style="font-size:10px;color:var(--text-tertiary);">${s.kelasLama||'?'} → dipindah</div></div>
            <button onclick="hapusScanNaik(${i})" class="btn-nav danger" style="width:26px;height:26px;font-size:10px;"><i class="fas fa-times"></i></button>
        </div>
    `).join('');
}

window.hapusScanNaik = function(i){listSiswaScanned.splice(i,1);renderListNaik();};
window.resetNaikKelas = function(){listSiswaScanned=[];renderListNaik();showToast('Reset','success');};

window.simpanNaikKelas = async function() {
    if(listSiswaScanned.length===0){showToast('Kosong!','error');return;}
    const tujuan=document.getElementById('kelasTujuan')?.value;
    if(!tujuan){showToast('Pilih kelas!','error');return;}
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const sorted=[...listSiswaScanned].sort((a,b)=>a.nama.localeCompare(b.nama));

        const existingSnap = await db.ref('siswa/'+tujuan).once('value');
        const existingData = existingSnap.val() || {};
        const konflik = [];
        for (let i=0;i<sorted.length;i++) {
            const absenBaru = String(i+1);
            const existing = existingData[absenBaru];
            if (existing && !(sorted[i].kelasLama===tujuan && String(sorted[i].absenLama)===absenBaru)) {
                const masihDipindah = sorted.some(s=>s.kelasLama===tujuan && String(s.absenLama)===absenBaru);
                if (!masihDipindah) konflik.push(`Absen ${absenBaru} di ${tujuan} sudah dipakai "${existing.nama}"`);
            }
        }
        if (konflik.length>0) {
            throw new Error('Konflik slot: '+konflik.join('; ')+'. Kosongkan/geser dulu siswa yang bentrok sebelum memindahkan.');
        }

        for(let i=0;i<sorted.length;i++){
            const s=sorted[i];
            const absenBaru=String(i+1);
            if(s.kelasLama&&s.absenLama)await db.ref('siswa/'+s.kelasLama+'/'+s.absenLama).remove();
            let kode=s.kodeUnik;
            if(!kode) kode=await generateKodeUnik();
            await db.ref('siswa/'+tujuan+'/'+absenBaru).set({nama:s.nama,kelas:tujuan,absen:absenBaru,jk:s.jk||'L',agama:s.agama||'Islam',kodeUnik:kode,warnaKartu:s.warnaKartu||'navy',totalHadir:s.totalHadir||0,terdaftar:s.terdaftar||Date.now()});
            await db.ref('kodeIndex/'+kode).set({kelas:tujuan,absen:absenBaru});
        }
        showToast(`${sorted.length} siswa ke ${tujuan}!`,'success');
        listSiswaScanned=[];renderListNaik();updateDashboard();loadManualAbsenOptions();
    }catch(e){showToast('Gagal: '+errMsg(e),'error');}
    document.getElementById('loadingOverlay').classList.remove('show');
};

window.resetTotalHadir = async function() {
    if(!confirm('Reset semua total hadir ke 0? Tidak bisa dibatalkan!'))return;
    document.getElementById('loadingOverlay').classList.add('show');
    try{
        const snap=await db.ref('siswa').once('value'),d=snap.val()||{},up={};
        for(let k in d)for(let a in d[k])up[`siswa/${k}/${a}/totalHadir`]=0;
        await db.ref().update(up);
        showToast('Berhasil direset!','success');updateDashboard();
    }catch(e){showToast('Gagal','error');}
    document.getElementById('loadingOverlay').classList.remove('show');
};

if('serviceWorker' in navigator){
    navigator.serviceWorker.getRegistrations().then(r=>r.forEach(reg=>reg.unregister())).catch(()=>{});
}

async function cekNamaSudahAda(namaUpper, kecualiKelas, kecualiAbsen) {
    const snap = await db.ref('siswa').once('value');
    const data = snap.val() || {};
    for (let k in data) {
        for (let a in data[k]) {
            if (k === kecualiKelas && String(a) === String(kecualiAbsen)) continue;
            if ((data[k][a].nama || '').toUpperCase().trim() === namaUpper) {
                return { kelas: k, absen: a };
            }
        }
    }
    return null;
}

function fillRound(ctx,x,y,w,h,r,color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x+r,y);
    ctx.arcTo(x+w,y,x+w,y+h,r);
    ctx.arcTo(x+w,y+h,x,y+h,r);
    ctx.arcTo(x,y+h,x,y,r);
    ctx.arcTo(x,y,x+w,y,r);
    ctx.closePath();
    ctx.fill();
}

function loadImageFromFile(src) {
    return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => {
            console.error('Gagal load:', src);
            reject(new Error('Gagal load: ' + src));
        };
        img.src = src;
    });
}

async function generateKartuCanvas({ nama, agama, kode, colorKey }) {
    const canvas = document.createElement('canvas');
    canvas.width = CARD_W;
    canvas.height = CARD_H;
    const ctx = canvas.getContext('2d');

    const isMuslim = String(agama || '').trim().toLowerCase() === 'islam';
    const prefix = isMuslim ? 'muslim' : 'nonmuslim';
    const templateFile = `templates/${prefix}_${colorKey}.png`;

    let bg;
    try {
        bg = await loadImageFromFile(templateFile);
    } catch(e) {
        const fallbackFile = isMuslim ? 'templates/muslim_navy.png' : 'templates/nonmuslim_navy.png';
        bg = await loadImageFromFile(fallbackFile);
    }

    ctx.drawImage(bg, 0, 0, CARD_W, CARD_H);

    const qrSize = 300;
    const qrX = (CARD_W - qrSize) / 2;
    const qrY = 380;

    ctx.shadowColor = 'rgba(0,0,0,0.15)';
    ctx.shadowBlur = 12;
    fillRound(ctx, qrX - 10, qrY - 10, qrSize + 20, qrSize + 20, 10, '#ffffff');
    ctx.shadowBlur = 0;

    const qrUrl = await qrDataUrl(kode, 350);
    const qrImg = await loadImage(qrUrl);
    ctx.drawImage(qrImg, qrX, qrY, qrSize, qrSize);

    let displayName = (nama || '').toUpperCase();
    const maxW = CARD_W * 0.66;
    let fontSize = 36;
    ctx.font = `900 ${fontSize}px Arial, sans-serif`;
    let textW = ctx.measureText(displayName).width;

    while (textW > maxW && fontSize > 8) {
        fontSize -= 2;
        ctx.font = `900 ${fontSize}px Arial, sans-serif`;
        textW = ctx.measureText(displayName).width;
    }

    if (textW > maxW) {
        let truncated = displayName;
        while (truncated.length > 15 && ctx.measureText(truncated + '...').width > maxW) {
            truncated = truncated.slice(0, -1);
        }
        displayName = truncated + '...';
        textW = ctx.measureText(displayName).width;
    }

    const namaY = qrY + qrSize + 72;

    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `900 ${fontSize}px Arial, sans-serif`;
    ctx.fillStyle = '#ffffff';
    ctx.shadowColor = 'rgba(0,0,0,0.6)';
    ctx.shadowBlur = 8;
    ctx.fillText(displayName, CARD_W/2, namaY);
    ctx.shadowBlur = 0;

    return canvas;
}

